# Replace URL with your Saleor backend. Make sure to keep the slash at the end.
# Dev (via Traefik): http://api.localhost:10000/graphql/
# Prod: https://your-domain.com/graphql/
NEXT_PUBLIC_SALEOR_API_URL=http://api.localhost:10000/graphql/

# make sure to add it on production for correct canonical URLs
# Dev (via Traefik): http://storefront.localhost:10000
NEXT_PUBLIC_STOREFRONT_URL=http://storefront.localhost:10000

# Set the default Saleor channel slug for the storefront.
# Used to redirect "/" to the specified channel path (e.g., "/en-gb", "/en-eu", "/fr-ca", "/it-eu").
NEXT_PUBLIC_DEFAULT_CHANNEL=default-channel

# Token used for fetching channels
SALEOR_APP_TOKEN=
