# Storefront environment configuration
# Copy this file to .env and fill in the values for your environment.

# Saleor GraphQL API endpoint (via Traefik)
# Dev:  http://api.localhost:10000/graphql/
# Prod: https://api.digidex.bio/graphql/
NEXT_PUBLIC_SALEOR_API_URL=http://api.localhost:10000/graphql/

# Public storefront URL (via Traefik)
# Dev:  http://storefront.localhost:10000
# Prod: https://storefront.digidex.bio
NEXT_PUBLIC_STOREFRONT_URL=http://storefront.localhost:10000

# Default Saleor channel slug
NEXT_PUBLIC_DEFAULT_CHANNEL=default-channel
