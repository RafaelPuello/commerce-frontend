# Storefront environment configuration
# Copy this file to .env and fill in the values for your environment.

# Saleor GraphQL API endpoint
# Dev:  http://localhost:3000/graphql/
# Prod: https://api.digidex.bio/graphql/
NEXT_PUBLIC_SALEOR_API_URL=http://localhost:3000/graphql/

# Public storefront URL
# Dev:  http://localhost:10000/shop
# Prod: https://shop.digidex.bio
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:10000/shop

# Default Saleor channel slug
NEXT_PUBLIC_DEFAULT_CHANNEL=default-channel
